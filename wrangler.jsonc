{
  // Static site for open.margincode.dev: serves site/ as is, no Worker code.
  "name": "open-margincode",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cloudflare's Git integration runs `wrangler preview` for non-production branches; it needs
  // this block, even empty.
  "previews": {},
  // Custom domain: the zone margincode.dev is on the Cloudflare account. A custom domain belongs
  // to one Worker: if open.margincode.dev is still attached to the earlier Worker
  // (scholion-deploy), remove it there first, or this deploy fails (site/README.md).
  "routes": [
    { "pattern": "open.margincode.dev", "custom_domain": true }
  ]
}
